# TP-Finance environment
APP_URL=http://localhost/tp-finance

# Internal staff SSO (tp-common SharedSession + SsoGuard). On prod this is forced.
# Local dev without tp-common installed: set FINANCE_REQUIRE_AUTH=0 to bypass.
FINANCE_REQUIRE_AUTH=0

# Read-layer sources (used from build phase P3 onward)
CRM_BASE_URL=https://crm.tp-asset.com
ERP_BASE_URL=https://erp.tp-asset.com
HR_BASE_URL=https://hr.tp-asset.com
CHECKIN_BASE_URL=https://checkin.tp-asset.com
TP_ERP_API_URL=https://erp.tp-asset.com/api/v1

# Read API keys. tp-finance remains read-only; owners are CRM/ERP/HR.
TP_ERP_API_KEY=
# Issue from tp-crm: php scripts/issue_crm_api_key.php "tp-finance read" finance.read
TP_CRM_API_KEY=
TP_HR_API_KEY=

# Optional read-only control mapping from Finance Flow accounts to tp-erp.
# Bank account IDs must come from tp-erp erp_bank_accounts; GL codes from chart of accounts.
FINANCE_INCOME_BANK_ACCOUNT_ID=
FINANCE_INCOME_GL_ACCOUNT_CODE=
FINANCE_PROJECT_BANK_ACCOUNT_ID=
FINANCE_PROJECT_GL_ACCOUNT_CODE=
FINANCE_EXPENSE_BANK_ACCOUNT_ID=
FINANCE_EXPENSE_GL_ACCOUNT_CODE=
FINANCE_HOLDING_BANK_ACCOUNT_ID=
FINANCE_HOLDING_GL_ACCOUNT_CODE=
FINANCE_WEB_MODE=redirect
